# Polymarket BTC Trading Bot Configuration
# Copy this file to .env and fill in your values

# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user ID (get from @userinfobot)
TELEGRAM_USER_ID=your_telegram_user_id_here

# ==========================================
# TRADING CONFIGURATION
# ==========================================
# SAFETY FIRST: Always start with DRY_RUN=true
DRY_RUN=true

# Maximum position size per trade (in USDC)
MAX_POSITION_SIZE=10.0

# Arbitrage threshold (sum of YES/NO prices)
TARGET_SUM=0.96

# Minimum edge required for trades
EDGE_THRESHOLD=0.02

# ==========================================
# POLYMARKET API CONFIGURATION
# ==========================================
# Get these from Polymarket API dashboard
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_API_SECRET=your_polymarket_api_secret_here
POLYMARKET_PASSPHRASE=your_polymarket_passphrase_here

# ==========================================
# PRICE FEED CONFIGURATION
# ==========================================
# Binance API (free tier usually sufficient)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Kraken API (alternative price feed)
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# ==========================================
# RISK MANAGEMENT
# ==========================================
# Daily loss limit (in USDC)
DAILY_LOSS_LIMIT=50.0

# Maximum drawdown percentage
MAX_DRAWDOWN_PCT=0.1

# Maximum trades per hour
MAX_TRADES_PER_HOUR=60

# ==========================================
# STRATEGY CONFIGURATION
# ==========================================
# Enable/disable strategies
ENABLE_ARBITRAGE=true
ENABLE_SNIPING=true
ENABLE_MOMENTUM=true
ENABLE_MARKET_MAKING=false

# Strategy-specific settings
ARBITRAGE_MIN_SPREAD=0.02
SNIPING_TIME_WINDOW=30
MOMENTUM_LOOKBACK=5

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=bot.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ==========================================
# ADVANCED CONFIGURATION
# ==========================================
# API rate limiting
REQUESTS_PER_MINUTE=60
BURST_LIMIT=10

# Retry configuration
MAX_RETRIES=3
RETRY_BACKOFF=1.0

# Market discovery
MARKET_DISCOVERY_INTERVAL=300
ORDER_BOOK_DEPTH=20

# ==========================================
# DEVELOPMENT SETTINGS
# ==========================================
# Enable debug mode
DEBUG=false

# Test mode (uses testnet if available)
TEST_MODE=false
