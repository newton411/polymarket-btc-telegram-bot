# ────────────────────────────────────────────────────────────────────────────
# RecondTrade Bot — Environment Configuration (.env)
# Copy to .env and fill in your credentials
# ────────────────────────────────────────────────────────────────────────────

# ── TELEGRAM ─────────────────────────────────────────────────────────────────
# Get from: https://t.me/BotFather
TELEGRAM_TOKEN=YOUR_TELEGRAM_TOKEN_HERE

# Your Telegram user ID (get from /start on your bot or from @userinfobot)
ALLOWED_USER_ID=123456789

# ── POLYMARKET / CLOB ────────────────────────────────────────────────────────
# Your Polymarket private key (for signing orders on Polygon)
POLYMARKET_PRIVATE_KEY=your_private_key_in_hex

# Your Polymarket/MetaMask wallet address (Polygon network)
POLYMARKET_ADDRESS=0x74299c15CcEf4b48B06633E44F4F131209E0d233

# ── TRADING CONFIGURATION ────────────────────────────────────────────────────
# DRY_RUN: Set to true for simulation (no real orders), false for live trading
DRY_RUN=true

# Arbitrage sum target (trigger at this level)
# E.g., 0.95 means: buy when best_ask_UP + best_ask_DOWN <= 0.95
ARB_SUM_TARGET=0.95

# Maximum position size per leg (in USD)
MAX_POSITION_USD=50

# Minimum edge to trigger (5% = 0.05)
EDGE_THRESHOLD=0.05

# How often to poll order books (seconds)
POLL_INTERVAL=2.0

# How often to update Telegram dashboard (seconds)
DASHBOARD_UPDATE_INTERVAL=15

# Daily loss limit (10% = 0.10) — stop trading if hit
DAILY_DRAWDOWN_STOP=0.10

# Max trades per hour (safety)
MAX_TRADES_PER_HOUR=300

# ── DATABASE ─────────────────────────────────────────────────────────────────
DB_PATH=./bot/data.db
POINTS_DB_PATH=./bot/points.db

# ── POLYGON (for Pro subscription verification) ──────────────────────────────
POLYGON_RPC=https://polygon-rpc.com

# ────────────────────────────────────────────────────────────────────────────
# SAFETY & WARNINGS
# ────────────────────────────────────────────────────────────────────────────
# 🚨 HIGH RISK: This bot can lose your entire capital
# 🚨 Only deploy with capital you can afford to lose
# 🚨 Start with DRY_RUN=true for extensive testing
# 🚨 Test with small position sizes first
# ────────────────────────────────────────────────────────────────────────────
DEBUG=false

# Test mode (uses testnet if available)
TEST_MODE=false
