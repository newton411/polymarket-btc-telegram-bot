# ============================================================
# RecondTrade Bot — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ── Telegram ──────────────────────────────────────────────
# Your bot token from @BotFather
TELEGRAM_TOKEN=8707545048:AAF2XduF-CJQ1pH5Ipqmdjl3riVe82S0toE

# Your Telegram user ID (get from @userinfobot)
# Only this user can control the bot
ALLOWED_USER_ID=your_telegram_user_id_here

# ── Polymarket Credentials ────────────────────────────────
# Your Polygon wallet private key (for signing orders)
POLYMARKET_PRIVATE_KEY=your_private_key_here

# Your wallet address (for CLOB client funder param)
# Wallet: 0xc7b9939135F5143D5b9eB968cf6f93566E31ff52
POLYMARKET_ADDRESS=0xc7b9939135F5143D5b9eB968cf6f93566E31ff52

# API credentials (derived from private key via ClobClient.derive_api_key())
# These are auto-derived on startup if POLYMARKET_PRIVATE_KEY is set
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ── Trading Mode ──────────────────────────────────────────
# SAFETY: Keep as "true" until you are ready for live trading
DRY_RUN=true

# Max USDC per trade leg
MAX_POSITION_SIZE=10.0

# Arbitrage target sum (YES+NO < this = opportunity found)
TARGET_SUM=0.96

# Minimum edge to trigger a trade
EDGE_THRESHOLD=0.02

# ── Risk Management ───────────────────────────────────────
# Daily drawdown stop (fraction of balance)
DAILY_DRAWDOWN_STOP=0.10

# Maximum trades per hour
MAX_TRADES_PER_HOUR=60

# ── Timing ────────────────────────────────────────────────
# Order book polling interval (seconds)
POLL_INTERVAL=3.0

# Dashboard Telegram update interval (seconds)
DASHBOARD_UPDATE_INTERVAL=30

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=bot.log
