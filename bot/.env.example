# ============================================================
# RecondTrade Bot — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Telegram ──────────────────────────────────────────────
# Your bot token from @BotFather
TELEGRAM_TOKEN=8707545048:AAF2XduF-CJQ1pH5Ipqmdjl3riVe82S0toE

# Your Telegram user ID (get yours from @userinfobot)
# Only this user can run owner-only commands
ALLOWED_USER_ID=your_telegram_user_id_here

# ── Creator / Subscription Wallet ─────────────────────────
# Polygon wallet that receives Pro subscription payments
POLYMARKET_ADDRESS=0x74299c15CcEf4b48B06633E44F4F131209E0d233

# ── Polymarket CLOB Credentials ───────────────────────────
# Required only for LIVE trading (not needed for dry-run)
# Your Polygon wallet private key (no 0x prefix)
POLYMARKET_PRIVATE_KEY=your_private_key_here

# CLOB API credentials (derived via ClobClient.derive_api_key())
# Leave blank to auto-derive on startup when PRIVATE_KEY is set
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ── Trading Mode ──────────────────────────────────────────
# SAFETY: Keep as "true" until you are fully ready for live trading
# In dry-run mode the bot logs "WOULD BUY" instead of placing real orders
DRY_RUN=true

# ── Strategy Parameters ───────────────────────────────────
# Trigger arb when YES_ask + NO_ask <= TARGET_SUM (override at runtime: /settarget)
TARGET_SUM=0.95

# Minimum edge (1 - sum) required to enter a trade
EDGE_THRESHOLD=0.02

# Number of shares to buy on each leg
TRADE_SIZE=25

# Maximum trades per hour (rate limiter)
MAX_TRADES_PER_HOUR=60

# ── Risk Management ───────────────────────────────────────
# Stop trading when daily P&L loss exceeds this fraction of starting balance
DAILY_DRAWDOWN_STOP=0.10

# ── Timing ────────────────────────────────────────────────
# Order book poll interval in seconds (min 1.0)
POLL_INTERVAL=2.0

# Dashboard Telegram message edit interval in seconds
DASHBOARD_UPDATE_INTERVAL=15

# ── Pro Subscription ──────────────────────────────────────
# Amount (MATIC on Polygon) required for Pro
PRO_PRICE_MATIC=5.0

# Pro subscription validity in days
PRO_DURATION_DAYS=30

# ── TGE ───────────────────────────────────────────────────
# URL sent when users type /tge
TGE_URL=https://recondt.io/tge

# ── External Verification ─────────────────────────────────
# Optional: Polygonscan API key for /verify command
# Without this key, any submitted tx_hash is auto-approved (testing only)
POLYGONSCAN_API_KEY=

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=bot.log
