# ── Polymarket API ────────────────────────────────────────────────────────────
# API wallet address (for authentication only — do NOT send funds here)
POLYMARKET_ADDRESS=0xc7b9939135F5143D5b9eB968cf6f93566E31ff52
# Private key for signing CLOB orders (NOT the custodial wallet key)
POLYMARKET_PK=0x...
POLYMARKET_API_KEY=...
POLYMARKET_API_PASSPHRASE=...
POLYMARKET_API_SECRET=...

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
TELEGRAM_ALLOWED_USER_ID=123456789

# ── Trading Engine ────────────────────────────────────────────────────────────
# DRY_RUN = simulate only | LIVE = place real orders
TRADING_MODE=DRY_RUN
EDGE_THRESHOLD=0.10
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15
MAX_POSITION_SIZE=10.0
INITIAL_BALANCE=5000.0

# ── Alerts ────────────────────────────────────────────────────────────────────
# Send a P&L alert when cumulative P&L moves by this many USDC
PNL_ALERT_THRESHOLD=5.0
